LRESULT CC4IMapView::move_with_coord(WPARAM w, LPARAM l)
{
	CStringArray* parray_value;
	parray_value = (CStringArray*)w;
	if (parray_value == NULL)
		return FALSE;
	if (parray_value->GetSize() < 2)
	{
		delete parray_value;
		return FALSE;
	}

	CString lat, lon;
	lat = parray_value->GetAt(0);
	lon = parray_value->GetAt(1);
	lat.Trim();
	lon.Trim();

	TCHAR* lonEnd = nullptr;
	TCHAR* latEnd = nullptr;
	double x = _tcstod(lon, &lonEnd);
	double y = _tcstod(lat, &latEnd);

	if (m_pCoordMgr)
	{
		double newX, newY;
		m_pCoordMgr->WorldLonLat2ScreenXY(x, y, &newX, &newY, m_pCoordMgr->m_fCenterX, m_pCoordMgr->m_fCenterY, m_pCoordMgr->m_fScale);
		m_pCoordMgr->SetNewCenter(newX, newY);

		//	DrawSituation(FALSE, FALSE, FALSE, FALSE);
		Invalidate(false);
	}
	delete parray_value;

	return TRUE;
}
